# Zonova Mist API — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored; NEVER commit real secrets.

# REQUIRED: MongoDB connection string (Atlas or local MongoDB)
MONGO_URI=

# REQUIRED: secret for signing JWT auth tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
BASE_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
TIMEZONE=Asia/Colombo

# REQUIRED in production: comma-separated list of browser origins allowed to
# call this API. If unset, the server falls back to allowing all origins and
# logs a warning at boot — do not rely on that in production.
# Production example: https://mist.zonova.lk,https://zonova.lk
# Local dev example:  http://localhost:8080,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# PayHere (added M2 — the migration seeds PaymentGatewayCredential from these)
# ---------------------------------------------------------------------------
# Encrypts gateway secrets at rest. REQUIRED before seeding credentials.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

PAYHERE_MODE=SANDBOX

# The APPROVED MAIN DOMAIN for the guest house merchant account.
#
# PayHere whitelists main domains ONLY — subdomains cannot be registered at all
# (confirmed by PayHere support, 2026-07-31). "mist.zonova.lk" is therefore
# NOT usable, and "zonova.lk" belongs to the gift shop's separate merchant
# account. Decided 2026-08-03: the guest house uses its own apex domain.
PAYHERE_APPROVED_DOMAIN=zonovamist.lk

# Where the guest booking site is served. Checkout must originate from the
# approved domain above, so these must agree.
FRONTEND_URL=https://zonovamist.lk

# Public base URL of THIS API — used to build notify_url. A server-to-server
# callback, so it does not need whitelisting (confirm per M0.1b).
API_PUBLIC_URL=https://api.zonova.lk

# From the GUEST HOUSE merchant account — a separate account from the
# zonova.lk gift shop, which PayHere requires for a different business model.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# Business App credentials for the Retrieval and Refund APIs.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Optional: Cloudinary (hotel image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: SMS gateway (booking reminder SMS)
USER_ID=
API_KEY=
HOTEL_NAME=

# REQUIRED for /api/contact: OpenWA WhatsApp gateway (behind Cloudflare Access).
# Obtain from the OpenWA gateway admin / Cloudflare Access service token.
OPENWA_API_KEY=
OPENWA_CF_CLIENT_ID=
OPENWA_CF_CLIENT_SECRET=
