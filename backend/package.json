{
  "name": "mapmarket-backend",
  "version": "1.0.0",
  "description": "Dummy backend for MapMarket Flutter app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate:payment": "node migrations/002_payment_foundation.js",
    "migrate:payment:dry": "node migrations/002_payment_foundation.js --dry-run",
    "verify:local": "node scripts/verify-local.js --confirm",
    "tenants": "node scripts/set-tenant-slug.js --list",
    "tenant:slug": "node scripts/set-tenant-slug.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.4",
    "agenda": "^5.0.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.1",
    "mongodb": "^6.18.0",
    "mongoose": "^8.17.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
